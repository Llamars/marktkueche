# Vorlage für den Server: kopieren nach ".env" (cp .env.production.example .env) und ausfüllen.
# Anleitung: DEPLOY.md

# Deine Domain (DNS-A-Eintrag muss auf die Server-IP zeigen). Caddy holt dafür das HTTPS-Zertifikat.
DOMAIN=marktkueche.example.de

# Konten nur mit Einladungscode eines Haushalts. Das allererste Konto auf dem Server geht ohne Code.
REGISTRATION=invite

# Optional: Freischaltcode, mit dem jemand ohne Einladung einen EIGENEN Haushalt anlegen darf
# (z. B. für Freunde). Nur Buchstaben und Ziffern, mindestens 12 Zeichen. Leer = nicht möglich.
SIGNUP_CODE=

# Erfundene Beispielangebote ausblenden
DEMO_OFFERS=false

# Anzahl täglicher Sicherungen in data/backups
BACKUP_KEEP=14

# Optional: KI-Funktionen. Achtung: Kosten entstehen für alle Nutzer auf deinem Schlüssel.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
