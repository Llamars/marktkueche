{
  "name": "marktkueche",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rezeptvorschläge aus aktuellen Supermarkt-Angeboten – mit Wochenplan, Einkaufswagen und Nährwerten.",
  "scripts": {
    "dev": "vite",
    "dev:mit-server": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "backup": "node --import tsx server/backup.ts",
    "data:bls": "node scripts/bls-subset.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.2",
    "vite": "6.4.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "cheerio": "1.0.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "lucide-react": "0.460.0",
    "multer": "1.4.5-lts.1",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "tsx": "^4.19.2",
    "zod": "3.25.76",
    "zustand": "5.0.2"
  },
  "allowScripts": {
    "esbuild@0.23.1": true,
    "esbuild@0.25.12": true
  },
  "engines": {
    "node": ">=22.13"
  }
}
