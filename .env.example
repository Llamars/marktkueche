# Kopiere diese Datei nach ".env" und trage deine Schlüssel ein.

# Claude (Anthropic) – für Prospekt-Auslesen, Instagram-/Text-Import und neue KI-Rezepte
# Schlüssel erstellen: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional anderes Modell (Standard: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Optional: Bild-KI für Fotos zu neuen KI-Rezepten (OpenAI Images API)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium

# Server
# API_PORT=8787
# HOST=127.0.0.1   # 0.0.0.0, um die App im WLAN vom Handy zu öffnen

# Betrieb auf einem eigenen Server: siehe .env.production.example und DEPLOY.md
# REGISTRATION=invite        # Konten nur mit Einladungscode (Standard: open)
# SIGNUP_CODE=               # Freischaltcode für einen eigenen Haushalt ohne Einladung
# DEMO_OFFERS=false          # erfundene Beispielangebote ausblenden
# COOKIE_SECURE=true         # nur hinter HTTPS
# TRUST_PROXY=uniquelocal    # Reverse-Proxy im privaten Netz vertrauen (Standard: loopback)
# DATA_DIR=/data             # Datenordner (Standard: server/storage)
# BACKUPS=true               # tägliche Sicherung (Standard: nur mit NODE_ENV=production)
# BACKUP_KEEP=14
